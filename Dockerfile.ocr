FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SCHOLAR_API_HOST=0.0.0.0 \
    SCHOLAR_DB_PATH=/data/scholar.sqlite3

# OCRmyPDF orchestrates these native tools. Keep the language packs explicit:
# adding every Tesseract language makes the runtime image unnecessarily large.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ghostscript \
        pngquant \
        qpdf \
        tesseract-ocr \
        tesseract-ocr-chi-sim \
        tesseract-ocr-eng \
        unpaper \
        fonts-dejavu-core \
        fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

RUN addgroup --system scholar && adduser --system --ingroup scholar scholar
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
COPY tests ./tests
RUN pip install --no-cache-dir ".[api,mcp,dev,ocr]"
RUN mkdir /data && chown scholar:scholar /data

USER scholar
EXPOSE 8000
CMD ["scholar-api"]
