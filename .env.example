# Copy this file to .env. Never commit real credentials.
# Free key for production use: https://openalex.org/settings/api
OPENALEX_API_KEY=
OPENALEX_MAILTO=researcher@example.org
# Request a key: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
# Paid Google Scholar connector key: https://serpapi.com/dashboard
SERPAPI_API_KEY=
# Fresh Google Scholar citation rounds (>=2). More rounds consume more SerpApi quota.
SCHOLAR_GOOGLE_CITATION_ROUNDS=4
ADS_API_TOKEN=
CROSSREF_MAILTO=researcher@example.org
ARXIV_MAILTO=researcher@example.org
EUROPE_PMC_EMAIL=researcher@example.org
# Optional but recommended for OpenCitations' shared public API.
OPENCITATIONS_ACCESS_TOKEN=
# Index v2 has no server-side pagination; refuse unexpectedly huge relation bodies.
OPENCITATIONS_MAX_RELATIONS=5000

# Optional SQLite audit/cache store. Uncomment to persist normalized results and raw responses.
# SCHOLAR_DB_PATH=.scholarly-retrieval/state.sqlite3
SCHOLAR_RUN_LIVE_TESTS=0

# Conservative Reference entity-linking policy. Recalibrate on your versioned gold set.
SCHOLAR_REFERENCE_AUTO_MATCH_THRESHOLD=0.92
SCHOLAR_REFERENCE_MINIMUM_MARGIN=0.08

SCHOLAR_API_HOST=127.0.0.1
SCHOLAR_API_PORT=8000
SCHOLAR_API_KEYS=
SCHOLAR_RATE_LIMIT_PER_MINUTE=60
SCHOLAR_API_MAX_REQUEST_BODY_BYTES=4194304
# Optional shared quota/job queue for horizontally scaled API + scholar-worker.
SCHOLAR_REDIS_URL=
SCHOLAR_REDIS_PREFIX=scholar
SCHOLAR_JOB_TTL_SECONDS=86400

SCHOLAR_MCP_TRANSPORT=stdio
SCHOLAR_MCP_HOST=127.0.0.1
SCHOLAR_MCP_PORT=8001
SCHOLAR_MCP_API_KEYS=
SCHOLAR_MCP_RATE_LIMIT_PER_MINUTE=60
SCHOLAR_MCP_MAX_REQUEST_BODY_BYTES=4194304
